{
    "webserver": {
        "HOST": "localhost",
        "PORT": 9000,
        "ENABLE_CURL_CLIENT": true,
        "SETTINGS": {
            "debug": true,
            "autoreload": true
        }
    },
    "api": {
        "API_PREFIX": "nameres",
        "API_VERSION": ""
    },
    "elasticsearch": {
        "ES_HOST": "http://elasticsearch.es-core-components.svc.cluster.local:9200",
        "ES_INDEX": "annotator-nameres",
        "ES_ALIAS": "annotator-nameres",
        "ES_DOC_TYPE": "node", 
        "ES_INDICES": {},
        "ES_ARGS": {
            "sniff": false,
            "request_timeout": 60
        }
    },
    "telemetry": {
        "OPENTELEMETRY_ENABLED": true,
        "OPENTELEMETRY_SERVICE_NAME": "Nameres",
        "OPENTELEMETRY_JAEGER_HOST": "http://jaeger-otel-collector.sri",
        "OPENTELEMETRY_JAEGER_PORT": 4318,
        "OPENTELEMETRY_EXCLUDED_URLS": ["^/$", "^/status$", "^/version$", "^/webapp", "^/favicon\\.ico$"]
    }
}
